{
    "version": "1.0.0",
    "description": "Single-binary, declarative-TOML, multi-shell Powerlevel10k port in Rust",
    "homepage": "https://github.com/scurran1986/powerlevel10k-rs",
    "license": {
        "identifier": "MIT-or-Apache-2.0",
        "url": "https://github.com/scurran1986/powerlevel10k-rs/blob/main/LICENSE-MIT"
    },
    "notes": [
        "To activate the prompt once installed, add one of these to your shell rc:",
        "  pwsh: Invoke-Expression (& p10k-rs init pwsh | Out-String)",
        "  bash (Git Bash): eval \"$(p10k-rs init bash)\"",
        "Run `p10k-rs verify` to confirm the bundled gitstatusd helper sha matches,",
        "and `p10k-rs daemon-health` to check the long-lived git daemon.",
        "Note: gitstatusd has no Windows port — the vcs segment uses ShellOut",
        "via git.exe on Windows. `verify` is therefore informational only on",
        "Windows. See https://github.com/scurran1986/powerlevel10k-rs/blob/main/docs/src/windows.md"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/scurran1986/powerlevel10k-rs/releases/download/v1.0.0/p10k-rs-1.0.0-x86_64-pc-windows-msvc.zip",
            "hash": "2ce78fc9f1489d5318221d06b581c220cdab41c95db0cf4d2e9510ace4c4a7f5",
            "extract_dir": "p10k-rs-1.0.0-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/scurran1986/powerlevel10k-rs/releases/download/v1.0.0/p10k-rs-1.0.0-aarch64-pc-windows-msvc.zip",
            "hash": "97c786d8352d240308ea5b3c543070b3589b5c62392d425928d1d760bab0e333",
            "extract_dir": "p10k-rs-1.0.0-aarch64-pc-windows-msvc"
        }
    },
    "bin": "p10k-rs.exe",
    "checkver": {
        "url": "https://api.github.com/repos/scurran1986/powerlevel10k-rs/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/scurran1986/powerlevel10k-rs/releases/download/v$version/p10k-rs-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "p10k-rs-$version-x86_64-pc-windows-msvc"
            },
            "arm64": {
                "url": "https://github.com/scurran1986/powerlevel10k-rs/releases/download/v$version/p10k-rs-$version-aarch64-pc-windows-msvc.zip",
                "extract_dir": "p10k-rs-$version-aarch64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
